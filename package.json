{
  "name": "@use-habitat/ht",
  "version": "0.4.8",
  "description": "Agent Session Observability",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/use-habitat/ht.git"
  },
  "homepage": "https://github.com/use-habitat/ht#readme",
  "bugs": "https://github.com/use-habitat/ht/issues",
  "files": [
    "src",
    "protocol",
    "install.sh",
    "ht.config.example.json",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "ht": "./src/entry.ts"
  },
  "scripts": {
    "apps:cli": "bun src/entry.ts",
    "dev": "bun src/entry.ts",
    "typecheck": "bun node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "protocol:generate": "bun scripts/generate-protocol-schema.ts",
    "protocol:check": "bun scripts/generate-protocol-schema.ts --check",
    "check": "bun run typecheck && bun run protocol:check && bun test",
    "build": "bun build src/entry.ts --compile --outfile dist/ht"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "commander": "^15.0.0",
    "fuzzysort": "^4.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
