{
  "$id": "https://raw.githubusercontent.com/use-habitat/ht/main/protocol/ingest-v2.schema.json",
  "title": "Habitat ingestion batch v2",
  "description": "The public wire contract produced by HT for Habitat-compatible ingestion APIs.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 2
    },
    "batchId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "mode": {
      "type": "string",
      "enum": [
        "baseline",
        "delta",
        "final"
      ]
    },
    "cursor": {
      "type": "object",
      "properties": {
        "from": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "to": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "from",
        "to"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "deviceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "nativeSessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "nativeParentSessionId": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "classification": {
          "type": "string",
          "enum": [
            "active",
            "archived",
            "fixture"
          ]
        },
        "pathHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "epoch": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "sourceSize": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "id",
        "deviceId",
        "provider",
        "nativeSessionId",
        "nativeParentSessionId",
        "classification",
        "pathHash",
        "epoch",
        "sourceSize",
        "capturedAt"
      ]
    },
    "session": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "kind": {
          "type": "string",
          "enum": [
            "root",
            "agent"
          ]
        },
        "title": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "maxLength": 4000
            },
            {
              "type": "null"
            }
          ]
        },
        "project": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "completed",
            "archived"
          ]
        },
        "startedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "attributes": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "id",
        "kind",
        "title",
        "project",
        "model",
        "status",
        "startedAt",
        "updatedAt",
        "attributes"
      ]
    },
    "events": {
      "readOnly": true,
      "maxItems": 100000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sequence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "actor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "content": {
            "default": [],
            "maxItems": 10000,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": {}
            }
          },
          "text": {
            "default": null,
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "toolName": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "maxLength": 512
              },
              {
                "type": "null"
              }
            ]
          },
          "attributes": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "usage": {
            "type": "object",
            "properties": {
              "inputTokens": {
                "default": 0,
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "outputTokens": {
                "default": 0,
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "cachedInputTokens": {
                "default": 0,
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "cacheCreationInputTokens": {
                "default": 0,
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "reasoningOutputTokens": {
                "default": 0,
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "inputTokens",
              "outputTokens",
              "cachedInputTokens",
              "cacheCreationInputTokens",
              "reasoningOutputTokens"
            ]
          }
        },
        "required": [
          "id",
          "sequence",
          "kind",
          "actor",
          "occurredAt",
          "content",
          "text",
          "toolName",
          "attributes"
        ]
      }
    },
    "redaction": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "replacements": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "version",
        "replacements"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "batchId",
    "mode",
    "cursor",
    "source",
    "session",
    "events",
    "redaction"
  ],
  "x-habitat-invariants": [
    "cursor.to must be greater than or equal to cursor.from",
    "baseline batches must start at cursor zero",
    "source.sourceSize must be greater than or equal to cursor.to",
    "final batches require a completed or archived session"
  ]
}
